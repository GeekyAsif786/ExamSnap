{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://examsnap.invalid/schema/preset.schema.json",
  "title": "ExamSnap preset",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "category", "last_verified", "sources", "documents"],
  "properties": {
    "id": { "$ref": "#/$defs/slug" },
    "name": { "type": "string", "minLength": 3 },
    "category": {
      "enum": ["Banking", "Government jobs", "Entrance exams", "Other"]
    },
    "notes": { "type": "string" },
    "last_verified": { "type": "string", "format": "date" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/document" }
    },
    "translations": {
      "description": "Optional text in other languages, keyed by a locale code from src/ui/i18n/locales.js (not en). Anything left out falls back to the English text. Locale codes and document ids are checked by scripts/check-presets.mjs.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z]{2}$" },
      "additionalProperties": { "$ref": "#/$defs/translation" }
    }
  },
  "$defs": {
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "notes": { "type": "string", "minLength": 1 },
        "documents": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "notes": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "type"],
      "properties": {
        "title": { "type": "string" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "type": {
          "description": "notice = official notification/bulletin stating the specs; portal = official site but not the spec document; secondary = coaching / news / third-party sites.",
          "enum": ["notice", "portal", "secondary"]
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "width", "height", "min_kb", "max_kb", "filename"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "label": { "type": "string" },
        "kind": { "enum": ["photo", "signature", "thumb", "document"] },
        "width": { "type": "integer", "minimum": 50, "maximum": 4000 },
        "height": { "type": "integer", "minimum": 30, "maximum": 4000 },
        "min_kb": { "type": "number", "exclusiveMinimum": 0 },
        "max_kb": {
          "description": "Must be greater than min_kb (enforced by scripts/check-presets.mjs).",
          "type": "number"
        },
        "filename": { "type": "string", "pattern": "^[A-Za-z0-9_-]+\\.jpg$" },
        "notes": { "type": "string" }
      }
    }
  }
}
