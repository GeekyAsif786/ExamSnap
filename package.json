{
  "name": "examsnap",
  "version": "0.0.0",
  "private": true,
  "description": "Resize photos and signatures to the exact pixel size and KB range Indian exam portals require, entirely in the browser.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "node scripts/check-presets.mjs && node scripts/bundle-presets.mjs --check && node scripts/update-readme.mjs --check && node scripts/check-size.mjs && node scripts/check-docs-size.mjs",
    "lint": "eslint .",
    "build:presets": "node scripts/bundle-presets.mjs",
    "dev": "node scripts/serve.mjs",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "icons": "node scripts/make-icons.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "labels": "node scripts/sync-labels.mjs",
    "update-readme": "node scripts/update-readme.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0"
  }
}
